rules_version = '2';

// Default deny. Clients read what the game publishes and, from the Answer
// ticket onward, write Answers inside their Slot's Window. Everything else
// goes through a callable running as the Admin SDK, which these rules do not
// apply to.
service cloud.firestore {
  match /databases/{database}/documents {

    // Published runtime knobs. Deliberately readable by a signed-out visitor:
    // the app has to know how long a Slot is before it has a uid. Never put a
    // secret in here.
    match /config/app {
      allow read: if true;
      allow write: if false;
    }

    // A Player's own document is server-written. It is readable by any signed-in
    // Player because Handles appear on the Leaderboard.
    match /players/{uid} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // The live Round. Readable by anyone, signed in or not: the whole point is
    // that a visitor can watch without an account. It never contains the
    // correct Choice, so publishing it gives nothing away that matters.
    match /rounds/{roundId} {
      allow read: if true;
      allow write: if false;
    }

    // A Player's own seat, so the client can tell whether it holds one.
    match /rounds/{roundId}/seatHolders/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    match /rounds/{roundId}/meta/{doc} {
      allow read: if true;
      allow write: if false;
    }

    // Answers. This block is the whole of the pacing guarantee.
    //
    // A Player cannot answer ahead, cannot answer late, and cannot answer
    // twice. None of that is enforced by hiding Questions — a client can read
    // its own traffic, and this game permits cheating on purpose. It is
    // enforced here, on the write, where it cannot be argued with.
    match /rounds/{roundId}/answers/{answerId} {
      function live() {
        return get(/databases/$(database)/documents/rounds/current).data;
      }
      function slot() {
        return live().slots[request.resource.data.slot];
      }
      // Absence means open, at every level: no config document, no field, or a
      // field of the wrong type all leave the game running. A missing document
      // must never be able to take the broadcast down.
      function gameOpen() {
        return !exists(/databases/$(database)/documents/config/app)
          || get(/databases/$(database)/documents/config/app)
               .data.get('killSwitch', false) != true;
      }

      allow create: if request.auth != null
        // A seat, taken at join, is what bounds the bill. Without this line the
        // cap would be advisory: anyone could keep answering without holding
        // one, and the guard that is supposed to act in real time would not.
        && exists(/databases/$(database)/documents/rounds/$(roundId)/seatHolders/$(request.auth.uid))
        && gameOpen()
        // One Answer per Player per Slot, by construction: the document id is
        // the only one this Player is allowed to write for this Slot, and
        // `create` refuses an id that already exists.
        && answerId == string(request.resource.data.slot) + '_' + request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && roundId == live().id
        && request.resource.data.slot is int
        && request.resource.data.slot == live().openSlot
        && request.resource.data.choice is string
        // Server time, not the client's. This is what makes the elapsed time
        // used for scoring honest rather than self-reported.
        && request.resource.data.answeredAt == request.time
        && request.time.toMillis() >= slot().opensAt
        && request.time.toMillis() <= slot().closesAt;

      // Never rewritten: an Answer is a record of what someone did at a moment.
      // The server folds scores in through the Admin SDK, which these rules do
      // not apply to.
      allow update, delete: if false;
      allow read: if request.auth != null && request.auth.uid == resource.data.uid;
    }

    // A Player's running total for a Round. Server-written; readable by anyone
    // so the Leaderboard can be built from it.
    match /rounds/{roundId}/entries/{uid} {
      allow read: if true;
      allow write: if false;
    }

    // The live standings: one document the whole audience listens to. Readable
    // by a signed-out visitor, like the Round itself.
    match /leaderboards/{board} {
      allow read: if true;
      allow write: if false;
    }

    // The Handle reservation table. Server-only both ways: a client that could
    // write here could squat a Handle, and one that could read here could turn
    // a Handle back into a uid.
    match /handles/{handle} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
